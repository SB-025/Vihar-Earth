# Copy to .env. Keep these values on the server, never in VITE_ variables.
RESEND_API_KEY=
# A bare email address on a domain verified in Resend:
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=bhansaris@gmail.com
# Local dev default. Set this to the actual HTTPS website origin in production.
SITE_URL=http://127.0.0.1:5173
# For hosting, set HOST=0.0.0.0 and PORT to the hosting platform's assigned port.
